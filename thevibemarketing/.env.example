# Copy to .env and apps/web/.env. Never commit real credentials.

# Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENAI_SKIP_POLISH=0
FIRECRAWL_API_KEY=
FIRECRAWL_ALLOW_JSON_EXTRACT=0
TAVILY_API_KEY=
COMPOSIO_API_KEY=
GITHUB_TOKEN=
E2B_API_KEY=
SUPERMEMORY_API_KEY=
REDDIT_USER_AGENT=
PAGESPEED_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
XAI_IMAGE_MODEL=
XAI_VISION_MODEL=

DEEP_RESEARCH_TIMEOUT_MS=55000
DEEP_RESEARCH_MAX_SCRAPES=3

INTERNAL_WORKER_SECRET=
# Vercel Cron sends this as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
ERROR_WEBHOOK_URL=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CAL_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GOOGLE_OAUTH=0

# Billing
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENV=test
DODO_PRODUCT_ID_SOLO=
DODO_PRODUCT_ID_STARTUP=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_WEBHOOK_ALLOW_UNSIGNED=0

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime
MARKETING_STORE_BACKEND=
VC_BRAIN_OWNER_ID=
VC_BRAIN_WORKSPACE_ID=
ALLOW_SHARED_WORKSPACE=0
USE_POSTGRES_DUAL=1
DUAL_WRITE_FAIL_CLOSED=1

ALLOW_OPEN_APP=0
AUTH_BYPASS=0
NEXT_PUBLIC_DEMO_DEFAULTS=0
